# Client environment example.
# Copy this file to client/.env.local for local development and fill in real values locally.
# Do not commit secrets here.

# Local example
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here
REACT_APP_WHATSAPP_NUMBER=255764770939

