# Client environment example.
# Copy this file to client/.env.local for local development and fill in real values locally.
# Do not commit secrets here.

REACT_APP_API_URL=https://api.nuurpath.com/api
REACT_APP_GOOGLE_CLIENT_ID=replace-with-google-client-id
REACT_APP_RECAPTCHA_SITE_KEY=replace-with-recaptcha-site-key

