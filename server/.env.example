# Server environment example.
# Copy this file to server/.env for local development and fill in real values locally.
# Do not commit real secrets.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Leave blank locally to use server/public/uploads and server/private/uploads.
UPLOAD_ROOT=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
JWT_SECRET=replace-with-a-strong-32-plus-character-secret
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace-with-email-user
EMAIL_PASS=replace-with-email-password
EMAIL_FROM=NuurPath <noreply@example.com>
ADMIN_EMAIL=admin@example.com
# Leave blank to disable Google login on the server.
GOOGLE_CLIENT_ID=your_google_client_id_here
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-admin-bootstrap-password
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=replace-with-demo-user-password
TEST_LOGIN_EMAIL=admin@example.com
TEST_LOGIN_PASSWORD=replace-with-test-login-password
# Public WhatsApp follow-up remains a frontend concern; configure the number in client/.env.local if needed.

# Production reference values:
# NODE_ENV=production
# CLIENT_URL=https://nuurpath.com
# API_BASE_URL=https://api.nuurpath.com
# ALLOWED_ORIGINS=https://nuurpath.com,https://www.nuurpath.com
# UPLOAD_ROOT=/var/data/nuurpath/uploads
