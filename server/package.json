{
  "name": "nuurpath-travels",
  "version": "2.0.0",
  "description": "Premium Travel Management Console",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js && node --check controllers/newsletterController.js && node --check routes/authRoutes.js && node --check routes/bookingRoutes.js && node --check routes/flightRoutes.js && node --check routes/mediaPostRoutes.js && node --check routes/newsletterRoutes.js && node --check routes/serviceRoutes.js && node --check routes/appointmentRoutes.js && node --check routes/packageBookingAdminRoutes.js && node --check routes/users.js",
    "db:push": "prisma db push",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test": "jest",
    "seed": "node seed-packages.js && node seed-services.js",
    "seed:services": "node seed-services.js",
    "db:check": "node check-db.js",
    "db:restart": "bash restart-db.sh",
    "kill": "npx kill-port 5000"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.15.0",
    "pg": "^8.18.0",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
