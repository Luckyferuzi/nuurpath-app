generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String    @unique
  username             String?   @unique
  password             String?
  role                 String    @default("user")
  emailSubscriptions   Boolean   @default(true)
  createdAt            DateTime  @default(now())
  passwordResetToken   String?
  passwordResetExpires DateTime?
  passwordChangedAt    DateTime?
  verificationToken    String?
  verificationTokenExpires DateTime?
  isVerified           Boolean   @default(false)
  bio                  String?
  contactInfo          String?
  profilePicture       String?
  googleId             String?   @unique


  privateConsultations PrivateConsultation[]
  assignedPrivateConsultations PrivateConsultation[] @relation("PrivateConsultationAssignedStaff")
  updatedPrivateConsultations  PrivateConsultation[] @relation("PrivateConsultationLastUpdatedBy")
  packageBookings      PackageBooking[]
  assignedPackageBookings PackageBooking[] @relation("PackageBookingAssignedStaff")
  updatedPackageBookings  PackageBooking[] @relation("PackageBookingLastUpdatedBy")
  flightBookings       FlightBooking[]
  assignedFlightBookings FlightBooking[] @relation("FlightBookingAssignedStaff")
  updatedFlightBookings  FlightBooking[] @relation("FlightBookingLastUpdatedBy")
  serviceInquiries     ServiceInquiry[]
  assignedServiceInquiries ServiceInquiry[] @relation("ServiceInquiryAssignedStaff")
  updatedServiceInquiries  ServiceInquiry[] @relation("ServiceInquiryLastUpdatedBy")
  appointments         Appointment[]
  reviews              Review[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  wishlist             Wishlist[]
  uploadedFiles        StoredFile[]
  mediaPostComments    MediaPostComment[]
  mediaPostInteractions MediaPostInteraction[]
  createdEmailCampaigns EmailCampaign[] @relation("EmailCampaignCreatedBy")
  updatedEmailCampaigns EmailCampaign[] @relation("EmailCampaignUpdatedBy")
}

model StoredFile {
  id               Int      @id @default(autoincrement())
  originalName     String
  mimeType         String
  size             Int
  data             Bytes
  category         String
  isPublic         Boolean  @default(false)
  uploadedByUserId Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  uploadedBy User? @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
}

model PrivateConsultation {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   // Add this line
  phone       String
  description String
  date        String
  time        String
  status      String   @default("Pending")
  adminNotes  String?
  assignedStaffId Int?
  assignedAt   DateTime?
  lastContactedAt DateTime?
  lastUpdatedByUserId Int?
  lastStatusChangedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])
  userId      Int?
  assignedStaff User?  @relation("PrivateConsultationAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  lastUpdatedBy User?  @relation("PrivateConsultationLastUpdatedBy", fields: [lastUpdatedByUserId], references: [id], onDelete: SetNull)

  @@index([assignedStaffId])
}


model Package {
  id            Int      @id @default(autoincrement())
  title         String
  destination   String
  duration      String
  type          String
  price         Float
  description   String
  itinerary     String?
  journeyStops  Json?
  isFeatured    Boolean  @default(false)
  displayOrder  Int      @default(0)
  featuredOrder Int?
  images        String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings PackageBooking[]
  mediaPosts MediaPost[]
  reviews  Review[]
  wishlist Wishlist[]

  @@index([displayOrder])
  @@index([isFeatured, featuredOrder])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  room      String
  author    String
  email     String
  message   String
  time      String
  createdAt DateTime @default(now())
  read      Boolean  @default(false) // Add this line
}

model PackageBooking {
  id             Int      @id @default(autoincrement())
  userId         Int?
  packageId      Int?
  packageTitleSnapshot String?
  passengers     Int
  locationFrom   String?
  travelDate     DateTime?
  prefClass      String   @default("Economy")
  contactName    String
  contactEmail   String
  contactPhone   String
  passportNumber String?
  passportExpiryDate DateTime?
  passportCopy       String?
  dateOfBirth    DateTime?
  nationality    String?
  specialRequests    String?
  notes              String?
  status         String   @default("Pending")
  adminNotes     String?
  assignedStaffId Int?
  assignedAt      DateTime?
  lastContactedAt DateTime?
  lastUpdatedByUserId Int?
  lastStatusChangedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User?    @relation(fields: [userId], references: [id])
  package       Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  assignedStaff User?    @relation("PackageBookingAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  lastUpdatedBy User?    @relation("PackageBookingLastUpdatedBy", fields: [lastUpdatedByUserId], references: [id], onDelete: SetNull)

  @@index([assignedStaffId])
}

model FlightBooking {
  id               Int       @id @default(autoincrement())
  userId           Int?
  from             String
  to               String
  departureDate    DateTime
  returnDate       DateTime?
  travelClass      String
  contactName      String
  contactEmail     String
  contactPhone     String
  passengers       Int       @default(1)
  passengerDetails Json?
  totalPrice       Float?
  status           String    @default("pending")
  adminNotes       String?
  assignedStaffId  Int?
  assignedAt       DateTime?
  lastContactedAt  DateTime?
  lastUpdatedByUserId Int?
  lastStatusChangedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user          User? @relation(fields: [userId], references: [id])
  assignedStaff User? @relation("FlightBookingAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  lastUpdatedBy User? @relation("FlightBookingLastUpdatedBy", fields: [lastUpdatedByUserId], references: [id], onDelete: SetNull)

  @@index([assignedStaffId])
}

model Appointment {
  id              Int      @id @default(autoincrement())
  userId          Int
  serviceType     String
  appointmentDate DateTime
  notes           String?
  contactName     String?
  contactPhone    String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  packageId Int?
  name      String?
  rating    Int
  comment   String?
  images    String[]
  videos    String[]
  isVisible Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id])
  package Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  bookingId Int?

  user User @relation(fields: [userId], references: [id])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NewsletterSubscriber {
  id             Int       @id @default(autoincrement())
  name           String?
  email          String    @unique
  isActive       Boolean   @default(true)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model EmailSuppression {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  reason    String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailCampaign {
  id              Int      @id @default(autoincrement())
  internalName    String
  subject         String
  audienceType    String
  messageType     String
  greetingStyle   String
  title           String
  preheader       String?
  body            String
  highlightTitle  String?
  highlightBody   String?
  ctaLabel        String?
  ctaUrl          String?
  signature       String
  status          String   @default("Draft")
  recipientCount  Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  lastSentAt      DateTime?
  lastTestSentAt  DateTime?
  lastError       String?
  createdByUserId Int?
  updatedByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User? @relation("EmailCampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("EmailCampaignUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  recipients EmailCampaignRecipient[]

  @@index([status, updatedAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model EmailCampaignRecipient {
  id           Int      @id @default(autoincrement())
  campaignId   Int
  email        String
  name         String?
  source       String
  deliveryType String   @default("LIVE")
  status       String   @default("Pending")
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([campaignId, deliveryType, status])
  @@index([email])
}

model MediaPost {
  id               Int       @id @default(autoincrement())
  title            String
  caption          String
  destination      String?
  eventDate        DateTime?
  videoUrl         String?
  images           String[]
  isPublished      Boolean   @default(false)
  displayOrder     Int       @default(0)
  relatedPackageId Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  relatedPackage Package? @relation(fields: [relatedPackageId], references: [id], onDelete: SetNull)
  comments       MediaPostComment[]
  interactions   MediaPostInteraction[]

  @@index([displayOrder])
  @@index([isPublished, displayOrder])
}

model MediaPostComment {
  id             Int       @id @default(autoincrement())
  mediaPostId    Int
  userId         Int?
  authorName     String
  authorLocation String?
  message        String
  createdAt      DateTime  @default(now())

  mediaPost MediaPost @relation(fields: [mediaPostId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mediaPostId, createdAt])
  @@index([userId])
}

model MediaPostInteraction {
  id         Int      @id @default(autoincrement())
  mediaPostId Int
  userId     Int?
  type       String
  visitorKey String
  createdAt  DateTime @default(now())

  mediaPost MediaPost @relation(fields: [mediaPostId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([mediaPostId, type, visitorKey])
  @@index([mediaPostId, createdAt])
  @@index([userId])
  @@index([type])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  packageId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([userId, packageId])
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  icon        String?
  price       Float?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inquiries   ServiceInquiry[]
}

model ServiceInquiry {
  id             Int      @id @default(autoincrement())
  userId         Int?
  serviceId      Int?
  serviceType    String
  contactName    String
  contactEmail   String
  contactPhone   String
  country        String?
  preferredDate  DateTime?
  applicants     Int?
  urgency        String?
  documentStatus String?
  message        String?
  status         String   @default("New")
  adminNotes     String?
  assignedStaffId Int?
  assignedAt      DateTime?
  lastContactedAt DateTime?
  lastUpdatedByUserId Int?
  lastStatusChangedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User?    @relation(fields: [userId], references: [id])
  service       Service? @relation(fields: [serviceId], references: [id])
  assignedStaff User?    @relation("ServiceInquiryAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  lastUpdatedBy User?    @relation("ServiceInquiryLastUpdatedBy", fields: [lastUpdatedByUserId], references: [id], onDelete: SetNull)

  @@index([assignedStaffId])
}

model SiteContent {
  key       String   @id
  content   String
  updatedAt DateTime @updatedAt
}
