<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= (typeof lang !== 'undefined' && lang === 'ar') ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.title %></title>
    <link rel="stylesheet" href="/css/modern.css">
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f3f4f6;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            color: #1f2937;
        }
        .home-container {
            background: white;
            padding: 3rem;
            border-radius: 16px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            text-align: center;
            max-width: 600px;
            width: 90%;
        }
        .btn-submit {
            display: inline-block;
            padding: 0.875rem 1.5rem;
            background-color: #4361ee;
            color: white;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            margin: 0.5rem;
            transition: background-color 0.2s;
        }
        .btn-submit:hover { background-color: #3730a3; }
    </style>
</head>
<body>
    <div class="home-container">
        <div style="text-align: right; margin-bottom: 2rem;">
            <select onchange="const url = new URL(window.location); url.searchParams.set('lang', this.value); window.location = url;" style="padding: 8px; border-radius: 4px; border: 1px solid #d1d5db; background-color: white; cursor: pointer;">
                <option value="en" <%= (typeof lang === 'undefined' || lang === 'en') ? 'selected' : '' %>>English</option>
                <option value="sw" <%= (typeof lang !== 'undefined' && lang === 'sw') ? 'selected' : '' %>>Swahili</option>
                <option value="ar" <%= (typeof lang !== 'undefined' && lang === 'ar') ? 'selected' : '' %>>Arabic</option>
            </select>
        </div>
        <h1 style="margin-bottom: 2rem; font-size: 2rem; color: #111827;"><%= t.title %></h1>
        
        <% if (typeof success !== 'undefined' && success) { %>
            <div style="background-color: #d1e7dd; color: #0f5132; padding: 1rem; margin-bottom: 2rem; border-radius: 8px;">
                <%= t.success_msg %>
            </div>
        <% } %>

        <div style="display: flex; justify-content: center; flex-wrap: wrap;">
            <a href="/book<%= typeof lang !== 'undefined' && lang ? '?lang=' + lang : '' %>" class="btn-submit"><%= t.book %></a>
            <a href="/news<%= typeof lang !== 'undefined' && lang ? '?lang=' + lang : '' %>" class="btn-submit" style="background-color: #6c757d;"><%= t.news %></a>
            <a href="/login<%= typeof lang !== 'undefined' && lang ? '?lang=' + lang : '' %>" class="btn-submit" style="background-color: #374151;">Admin Login</a>
        </div>
    </div>
</body>
</html>