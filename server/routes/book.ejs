<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= (typeof lang !== 'undefined' && lang === 'ar') ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.book_trip %> - <%= t.title %></title>
    <link rel="stylesheet" href="/css/modern.css">
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f3f4f6;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            color: #1f2937;
        }
        .booking-container {
            background: white;
            padding: 2.5rem;
            border-radius: 16px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 500px;
        }
        .form-group {
            margin-bottom: 1.5rem;
        }
        label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            color: #374151;
        }
        input, select {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            box-sizing: border-box;
            transition: border-color 0.15s ease;
            font-size: 1rem;
        }
        input:focus, select:focus {
            outline: none;
            border-color: #4361ee;
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
        }
        .btn-submit {
            width: 100%;
            padding: 0.875rem;
            background-color: #4361ee;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
            font-size: 1rem;
        }
        .btn-submit:hover {
            background-color: #3730a3;
        }
        .back-link {
            display: block;
            text-align: center;
            margin-top: 1rem;
            color: #6b7280;
            text-decoration: none;
            font-size: 0.875rem;
        }
    </style>
</head>
<body>
    <div class="booking-container">
        <div style="text-align: right; margin-bottom: 1rem;">
            <select onchange="const url = new URL(window.location); url.searchParams.set('lang', this.value); window.location = url;" style="padding: 8px; border-radius: 4px; border: 1px solid #d1d5db; background-color: white; cursor: pointer;">
                <option value="en" <%= (typeof lang === 'undefined' || lang === 'en') ? 'selected' : '' %>>English</option>
                <option value="sw" <%= (typeof lang !== 'undefined' && lang === 'sw') ? 'selected' : '' %>>Swahili</option>
                <option value="ar" <%= (typeof lang !== 'undefined' && lang === 'ar') ? 'selected' : '' %>>Arabic</option>
            </select>
        </div>
        <h1 style="text-align: center; margin-bottom: 2rem; color: #111827; font-size: 1.5rem;"><%= t.book_trip %></h1>
        <form action="/api/bookings" method="POST">
            <% if (typeof lang !== 'undefined' && lang) { %>
                <input type="hidden" name="lang" value="<%= lang %>">
            <% } %>
            <div class="form-group">
                <label for="fullName"><%= t.full_name %></label>
                <input type="text" id="fullName" name="fullName" required placeholder="<%= t.enter_full_name %>">
            </div>
            <div class="form-group">
                <label for="email"><%= t.email %></label>
                <input type="email" id="email" name="email" required placeholder="<%= t.enter_email %>">
            </div>
            <div class="form-group">
                <label for="package"><%= t.select_package %></label>
                <select id="package" name="package" required>
                    <option value=""><%= t.choose_dest %></option>
                    <option value="hajj-package">Hajj Package</option>
                    <option value="umrah-package">Umrah Package</option>
                    <option value="istanbul-tour">Istanbul Tour</option>
                    <option value="dubai-safari">Dubai Safari</option>
                </select>
            </div>
            <div class="form-group">
                <label for="date"><%= t.travel_date %></label>
                <input type="date" id="date" name="date" required>
            </div>
            <button type="submit" class="btn-submit"><%= t.confirm %></button>
        </form>
        <a href="/" class="back-link"><%= t.back_home %></a>
    </div>
</body>
</html>