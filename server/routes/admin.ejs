<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - NuurPath Travels</title>
    <link rel="stylesheet" href="/css/modern.css">
    <style>
        /* Modern Dashboard Styles */
        :root {
            --primary: #4361ee;
            --secondary: #3f37c9;
            --success: #4cc9f0;
            --danger: #f72585;
            --light: #f8f9fa;
            --dark: #212529;
            --gray: #6c757d;
            --border: #dee2e6;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f3f4f6;
            color: var(--dark);
            line-height: 1.5;
        }

        .news-container {
            background: white;
            border-radius: 16px;
            box-shadow: var(--shadow);
            padding: 2rem !important;
            margin-top: 2rem !important;
            border: 1px solid rgba(0,0,0,0.05);
        }

        h1 {
            font-size: 1.875rem;
            font-weight: 700;
            color: #111827;
            letter-spacing: -0.025em;
        }

        /* Modernize Buttons */
        .btn-submit {
            border-radius: 8px !important;
            font-weight: 600 !important;
            transition: all 0.2s ease !important;
            border: none !important;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }

        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            opacity: 0.95;
        }

        /* Modernize Table */
        .admin-table {
            border-collapse: separate;
            border-spacing: 0;
            width: 100%;
        }

        .admin-table th {
            background-color: #f9fafb;
            color: #6b7280;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid var(--border);
        }

        .admin-table td {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid var(--border);
            color: #374151;
            font-size: 0.875rem;
        }

        .admin-table tr:last-child td {
            border-bottom: none;
        }

        .admin-table tr:hover td {
            background-color: #f9fafb;
        }

        /* Status Badge Style for Package */
        .admin-table td span {
            background-color: #e0e7ff;
            color: #4338ca;
            padding: 4px 12px;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600 !important;
        }

        /* Action Buttons */
        .btn-edit {
            color: var(--primary);
            background: #eef2ff;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: 500;
            transition: background 0.2s;
        }
        
        .btn-edit:hover {
            background: #e0e7ff;
        }

        .btn-delete {
            color: #ef4444;
            background: #fef2f2;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: 500;
            border: none;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-delete:hover {
            background: #fee2e2;
        }

        /* Search Input */
        .search-input {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0.625rem 1rem;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        
        .search-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.15);
        }

        /* Pagination */
        .pagination {
            margin-top: 2rem;
            gap: 0.5rem;
        }

        .pagination a {
            border-radius: 8px;
            border: 1px solid var(--border);
            color: #374151;
            font-weight: 500;
            padding: 0.5rem 1rem;
        }

        .pagination a.active {
            background-color: var(--primary);
            color: white;
            border-color: var(--primary);
        }
    </style>
</head>
<body>
    <div class="news-container" style="max-width: 1200px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <h1>Booking Dashboard</h1>
            <div>
                <select onchange="const url = new URL(window.location); url.searchParams.set('lang', this.value); window.location = url;" style="padding: 10px; margin-right: 10px; border-radius: 4px; border: 1px solid #ced4da; background-color: white; cursor: pointer;">
                    <option value="en" <%= (typeof lang === 'undefined' || lang === 'en') ? 'selected' : '' %>>English</option>
                    <option value="sw" <%= (typeof lang !== 'undefined' && lang === 'sw') ? 'selected' : '' %>>Swahili</option>
                    <option value="ar" <%= (typeof lang !== 'undefined' && lang === 'ar') ? 'selected' : '' %>>Arabic</option>
                </select>
                <a href="/<%= typeof lang !== 'undefined' && lang ? '?lang=' + lang : '' %>" class="btn-submit" style="width: auto; text-decoration: none; padding: 10px 20px; margin-right: 10px; background-color: #6c757d;">Home</a>
                <a href="/book<%= typeof lang !== 'undefined' && lang ? '?lang=' + lang : '' %>" target="_blank" class="btn-submit" style="width: auto; text-decoration: none; padding: 10px 20px; margin-right: 10px; background-color: #007bff;">Book Now</a>
                <a href="/logout" class="btn-submit" style="width: auto; text-decoration: none; padding: 10px 20px; background-color: #dc3545;">Logout</a>
            </div>
        </div>

        <div class="admin-actions">
            <form action="/admin" method="GET" class="search-form">
                <% if (typeof lang !== 'undefined' && lang) { %>
                    <input type="hidden" name="lang" value="<%= lang %>">
                <% } %>
                <input type="text" name="search" placeholder="Search by name or email..." value="<%= typeof search !== 'undefined' ? search : '' %>" class="form-control search-input">
                <button type="submit" class="btn-submit search-btn">Search</button>
                <% if (typeof search !== 'undefined' && search) { %>
                    <a href="/admin" class="btn-submit" style="background-color: #6c757d; width: auto; text-decoration: none; padding: 10px 20px;">Clear</a>
                <% } %>
            </form>
            <a href="/admin/export" class="btn-submit btn-export">Export CSV</a>
        </div>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Date Booked</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Package</th>
                        <th>Travel Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (bookings.length > 0) { %>
                        <% bookings.forEach(function(booking) { %>
                            <tr>
                                <td><%= new Date(booking.createdAt).toLocaleDateString() %></td>
                                <td><%= booking.fullName %></td>
                                <td><%= booking.email %></td>
                                <td>
                                    <span style="text-transform: capitalize; font-weight: 500;">
                                        <%= booking.package ? booking.package.replace(/-/g, ' ') : 'N/A' %>
                                    </span>
                                </td>
                                <td><%= new Date(booking.date).toDateString() %></td>
                                <td>
                                    <a href="/admin/edit/<%= booking.id %>" class="btn-edit">Edit</a>
                                    <form action="/admin/delete/<%= booking.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this booking?');" style="margin: 0;">
                                        <button type="submit" class="btn-delete">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 30px;">No bookings found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
            <div class="pagination">
                <% if (currentPage > 1) { %>
                    <a href="/admin?page=<%= currentPage - 1 %><%= typeof search !== 'undefined' && search ? '&search=' + search : '' %><%= typeof lang !== 'undefined' && lang ? '&lang=' + lang : '' %>">&laquo; Prev</a>
                <% } %>
                
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="/admin?page=<%= i %><%= typeof search !== 'undefined' && search ? '&search=' + search : '' %><%= typeof lang !== 'undefined' && lang ? '&lang=' + lang : '' %>" class="<%= currentPage === i ? 'active' : '' %>"><%= i %></a>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <a href="/admin?page=<%= currentPage + 1 %><%= typeof search !== 'undefined' && search ? '&search=' + search : '' %><%= typeof lang !== 'undefined' && lang ? '&lang=' + lang : '' %>">Next &raquo;</a>
                <% } %>
            </div>
        <% } %>
    </div>
</body>
</html>