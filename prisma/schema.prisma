generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  role      String   @default("user")
  createdAt DateTime @default(now())
  profilePicture String?
  bio       String?
  contactInfo String?
  preferences Json?
  passwordChangedAt DateTime?
  isVerified Boolean @default(false)
  verificationToken String?
  passwordResetToken String?
  passwordResetExpires DateTime?
  bookings          PackageBooking[]
  consultations     PrivateConsultation[]
  flightBookings    FlightBooking[]
  reviews           Review[]
  wishlist          Wishlist[]
  notifications     Notification[]
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteContent {
  key       String   @id
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

model Package {
  id          Int              @id @default(autoincrement())
  title       String
  destination String
  duration    String
  type        String
  price       Decimal          @db.Decimal(10, 2)
  images      String[]
  isFeatured  Boolean          @default(false)
  description String           @db.Text
  itinerary   String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  bookings    PackageBooking[]
  wishlistedBy Wishlist[]
}

model PackageBooking {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  packageId    Int
  package      Package  @relation(fields: [packageId], references: [id])
  travelDate   DateTime
  passengers   Int
  contactName  String
  contactEmail String
  contactPhone String
  locationFrom String?
  passportNumber String?
  passportExpiryDate DateTime?
  dateOfBirth  DateTime?
  nationality  String?
  specialRequests String?
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  packageId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  package Package @relation(fields: [packageId], references: [id])

  @@unique([userId, packageId])
}

model Review {
  id        Int      @id @default(autoincrement())
  name      String
  rating    Int
  comment   String   @db.Text
  isVisible Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  room      String
  author    String
  email     String
  message   String   @db.Text
  time      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PrivateConsultation {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?
  phone       String
  description String   @db.Text
  date        String
  time        String
  status      String   @default("Pending")
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  bookingId Int?
  booking   PackageBooking? @relation(fields: [bookingId], references: [id])
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
}

model FlightBooking {
  id           Int      @id @default(autoincrement())
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
  from         String
  to           String
  departureDate DateTime
  returnDate   DateTime?
  passengers   Int
  travelClass  String
  contactName  String
  contactEmail String
  contactPhone String
  locationFrom String?
  passportNumber String?
  passportExpiryDate DateTime?
  passportCopy String?
  dateOfBirth  DateTime?
  nationality  String?
  specialRequests String?
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}