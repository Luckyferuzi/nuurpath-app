# Root environment example for Docker Compose or other local orchestration only.
# Do not commit real secrets.

NODE_ENV=production
PORT=5001
CLIENT_URL=https://nuurpath.com
API_BASE_URL=https://api.nuurpath.com
ALLOWED_ORIGINS=https://nuurpath.com,https://www.nuurpath.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
JWT_SECRET=replace-with-a-strong-32-plus-character-secret
# Optional legacy filesystem fallback for self-hosted historical uploads only.
# Leave unset when using Neon-backed media storage.
# UPLOAD_ROOT=
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace-with-email-user
EMAIL_PASS=replace-with-email-password
EMAIL_FROM=NuurPath <noreply@example.com>
ADMIN_EMAIL=admin@example.com
ADMIN_SETUP_TOKEN=replace-with-a-long-random-first-admin-setup-token
GOOGLE_CLIENT_ID=replace-with-google-client-id
# Optional local bootstrap helpers if you prefer scripted seeding instead of the one-time /staff/setup flow.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-admin-bootstrap-password
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=replace-with-demo-user-password
TEST_LOGIN_EMAIL=admin@example.com
TEST_LOGIN_PASSWORD=replace-with-test-login-password

REACT_APP_API_URL=https://api.nuurpath.com/api
REACT_APP_GOOGLE_CLIENT_ID=replace-with-google-client-id
REACT_APP_WHATSAPP_NUMBER=255764770939

# Optional local Postgres values for docker-compose development.
POSTGRES_PORT=5432
POSTGRES_USER=nuurpath
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_DB=nuurpath_travels
